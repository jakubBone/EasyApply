# Backend environment for running WITHOUT Docker (./mvnw spring-boot:run).
# Read by spring-dotenv from this directory — the repo-root .env is a different
# file, used only by docker-compose. In Docker this file is never read (it is not
# copied into the image); values come from docker-compose.yml instead.
#
# Copy to .env:
#   cp .env.example .env

# -------------------------------------------
# Database — a local PostgreSQL must be running
# -------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/applikon_db
DATABASE_USERNAME=
DATABASE_PASSWORD=

# -------------------------------------------
# Google OAuth2 — create credentials at https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
# -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------------------
# HMAC secret for refresh-token hashes.
# Generate with: openssl rand -base64 32
# -------------------------------------------
APP_TOKEN_HMAC_SECRET=

# -------------------------------------------
# Groq API key — company brief generation (free, https://console.groq.com/keys)
# REQUIRED while brief.provider=groq: Spring AI's auto-configured OpenAI client
# asserts a non-blank key when the bean is built, so a blank one fails startup —
# the whole application, not just briefs.
# -------------------------------------------
GROQ_API_KEY=

# -------------------------------------------
# Gemini API key — dormant return-path provider (ADR-005).
# Blank is fine: read only when brief.provider=gemini.
# -------------------------------------------
GEMINI_API_KEY=

# Not needed here: ADMIN_KEY (the local profile sets its own), plus everything
# with a default in application.properties — PORT, UPLOAD_DIR,
# CORS_ALLOWED_ORIGINS, FRONTEND_URL, JWT_*.
